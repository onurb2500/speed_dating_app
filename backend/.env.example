# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://speed:speed@localhost:5432/speed_dating

# ─── Cache (Redis) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ───────────────────────────────────────────────────────────
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents below (use \n for line breaks, or a multi-line value).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Random 64-char hex used to hash stored refresh tokens.
#   openssl rand -hex 32
REFRESH_TOKEN_SECRET=replace_with_64_char_hex

# ─── Mux (video hosting) ───────────────────────────────────────────────────
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_signing_secret

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist (no trailing slash).
CORS_ORIGINS=http://localhost:3000
